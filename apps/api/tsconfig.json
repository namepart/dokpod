{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Node",
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist",
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@dokploy/server/*": ["../../packages/server/src/*"],
			"@dokploy/server/dist/*": ["../../packages/server/dist/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "../../packages/server/src/**/*"],
	"ts-node": {
		"esm": true
	}
}
