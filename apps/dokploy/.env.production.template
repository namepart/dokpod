# Production Environment Configuration Template
# Copy this file to .env and fill in your production values

# ============================================================================
# CORE APPLICATION CONFIGURATION
# ============================================================================

# Application Environment
NODE_ENV=production
BUILD_MODE=production
HOST=0.0.0.0
PORT=3000

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql://username:password@host:port/database_name

# Authentication (REQUIRED)
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-very-long-secure-secret-key-minimum-32-characters

# ============================================================================
# BILLING SYSTEM CONFIGURATION
# ============================================================================

# WHMCS Integration (Optional - Enable if using WHMCS)
WHMCS_ENABLED=false
WHMCS_URL=https://your-whmcs-domain.com
WHMCS_IDENTIFIER=your_api_identifier
WHMCS_SECRET=your_api_secret
WHMCS_WEBHOOK_SECRET=your_webhook_secret

# Stripe Integration (Optional - Enable if using Stripe)
STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal Integration (Optional - Enable if using PayPal)
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=your_webhook_id

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================

# Traefik SSL Configuration (Optional - for automatic SSL)
TRAEFIK_ACME_EMAIL=your-email@domain.com
TRAEFIK_SSL_PROVIDER=letsencrypt

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Docker Socket (Default values - usually don't need to change)
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# ============================================================================
# MONITORING AND LOGGING
# ============================================================================

# Enable logging features
ENABLE_ACCESS_LOGS=true
LOG_CLEANUP_CRON=0 0 * * *

# ============================================================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================================================

# 1. DATABASE MIGRATION:
#    Before first deployment, run:
#    psql -d your_database -f apps/dokploy/drizzle/0107_billing_system.sql

# 2. NODE VERSION:
#    Use Node.js v20.16.0 in production

# 3. BUILD VERIFICATION:
#    Test build with: cd apps/dokploy && pnpm build-server && pnpm build-next

# 4. SSL SETUP:
#    Ensure your domain points to your server and TRAEFIK_ACME_EMAIL is set

# 5. BACKUP STRATEGY:
#    Configure automated database backups (see backup-strategy.md)

# 6. MONITORING:
#    Health check endpoints available at:
#    - GET /api/health/billing
#    - GET /api/status

# ============================================================================
# VALIDATION CHECKLIST
# ============================================================================
# □ DATABASE_URL is configured and accessible
# □ NEXTAUTH_SECRET is set and secure (32+ characters)
# □ At least one billing provider is enabled if needed
# □ Domain is configured and pointing to server
# □ SSL certificates are configured
# □ Database migration is completed
# □ Backups are configured and tested