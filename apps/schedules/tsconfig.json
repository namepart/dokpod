{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Node",
		"strict": false,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"declaration": false,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"noImplicitAny": false,
		"noImplicitReturns": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@dokploy/server/*": ["../../packages/server/src/*"],
			"@dokploy/server/dist/*": ["../../packages/server/dist/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "../../packages/server/src/**/*"],
	"ts-node": {
		"esm": true
	}
}
